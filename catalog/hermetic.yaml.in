name: hermetic
repo: https://github.com/forefy/hermetic
sha: {{SHA}}
version: "{{VERSION}}"
requires_hermes: "{{REQUIRES}}"
description: "Status-bar popover for Hermes Desktop with three views: Costs (spend, cache, pricing drift, OpenRouter provider routing), AAI (skill changes, ratings, tests and replays) and HDR (posture, destinations, sensitive paths, what runs on its own)."
maintainer: forefy
tier: community
category: desktop
docs_url: https://github.com/forefy/hermetic#readme
screenshots:
  - https://raw.githubusercontent.com/forefy/hermetic/{{SHA}}/docs/hermetic-costs.png
  - https://raw.githubusercontent.com/forefy/hermetic/{{SHA}}/docs/hermetic-aai.png
  - https://raw.githubusercontent.com/forefy/hermetic/{{SHA}}/docs/hermetic-hdr.png
  - https://raw.githubusercontent.com/forefy/hermetic/{{SHA}}/docs/hermetic-providers.png
  - https://raw.githubusercontent.com/forefy/hermetic/{{SHA}}/docs/hermetic-hdr-pipeline.png
  - https://raw.githubusercontent.com/forefy/hermetic/{{SHA}}/docs/hermetic-aai-settings.png
capabilities:
  provides_tools: []
  provides_hooks:{{HOOKS}}
  provides_middleware:{{MIDDLEWARE}}
  requires_env: []
